+/* Clean Start resets the previous MQTT 5 session at CONNECT; Session Expiry
+ * governs persistence of the new session. Bridges retain their local policy. */
+static bool persist__client_should_save(const struct mosquitto *context)
+{
+	if(!context || context->session_expiry_interval == MQTT_SESSION_EXPIRY_IMMEDIATE){
+		return false;
+	}
+#ifdef WITH_BRIDGE
+	if(context->bridge){
+		return context->bridge->clean_start_local == false;
+	}
+#endif
+	return context->protocol == mosq_p_mqtt5 || context->clean_start == false;
+}
