{
  "version": 1,
  "excluded": {
    "cloudflared": "Public tunnel explicitly off in local DEV; supported tunnel profile retained",
    "build": "Finite companion compiler, invoked on source changes; not a runtime service",
    "web-build": "Finite static asset compiler, invoked on source changes; not a runtime service"
  },
  "services": [
    {
      "name": "db-migrate",
      "container": "ukmesh-full-db-migrate-1",
      "kind": "oneshot",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM public.schema_migrations WHERE name='152_bound_retention_calendar_intervals.sql'"
        }
      ]
    },
    {
      "name": "backend",
      "container": "ukmesh-full-backend-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "http",
          "url": "http://127.0.0.1:3100/readyz",
          "json_path": "status",
          "equals": "ready"
        },
        {
          "kind": "metric",
          "url": "http://127.0.0.1:9091/metrics",
          "pattern": "^meshcore_mqtt_delivery_probe_healthy (\\d+)"
        }
      ]
    },
    {
      "name": "path-learning-worker",
      "container": "ukmesh-full-path-learning-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM analytics.path_model_calibration WHERE updated_at > now() - interval '2 hours'"
        }
      ]
    },
    {
      "name": "health-worker",
      "container": "ukmesh-full-health-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM ops.worker_health_snapshots WHERE ts > now() - interval '15 minutes'"
        }
      ]
    },
    {
      "name": "tagger-worker",
      "container": "ukmesh-full-tagger-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM mesh.message_tags"
        }
      ]
    },
    {
      "name": "region-snapshot-worker",
      "container": "ukmesh-full-region-snapshot-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "metric",
          "url": "http://127.0.0.1:9092/metrics",
          "pattern": "^meshcore_worker_outcomes_total\\{worker=\"region_scope\",phase=\"rebuild\",outcome=\"success\"\\} (\\d+)"
        }
      ]
    },
    {
      "name": "privacy-remat-worker",
      "container": "ukmesh-full-privacy-remat-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "command",
          "command": [
            "python3",
            "scripts/full-dev/work.py",
            "privacy-remat-worker"
          ],
          "timeout": 30
        }
      ]
    },
    {
      "name": "synthetic-monitor",
      "container": "ukmesh-full-synthetic-monitor-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM ops.operational_check_results WHERE status='ok' AND ts > now() - interval '15 minutes'"
        }
      ]
    },
    {
      "name": "link-backfill-worker",
      "container": "ukmesh-full-link-backfill-worker-1",
      "kind": "oneshot",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM core.node_links"
        }
      ]
    },
    {
      "name": "link-worker",
      "container": "ukmesh-full-link-worker-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "sql",
          "container": "ukmesh-sample-db",
          "user": "meshcore",
          "database_target": "ukmesh",
          "query": "SELECT count(*) FROM ops.link_job_commits"
        }
      ]
    },
    {
      "name": "hopreach",
      "container": "ukmesh-full-hopreach-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "command",
          "command": [
            "python3",
            "scripts/full-dev/work.py",
            "hopreach"
          ],
          "timeout": 30
        }
      ]
    },
    {
      "name": "app-ukmesh",
      "container": "ukmesh-full-app-ukmesh-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "http",
          "url": "http://127.0.0.1:3003/build-target.json",
          "json_path": "target",
          "equals": "app"
        },
        {
          "kind": "http",
          "url": "http://127.0.0.1:3003/api/nodes/map?network=ukmesh&limit=20",
          "min": 1,
          "json_path": "nodes"
        }
      ]
    },
    {
      "name": "website-ukmesh",
      "container": "ukmesh-full-website-ukmesh-1",
      "kind": "container",
      "required": true,
      "work": [
        {
          "kind": "http",
          "url": "http://127.0.0.1:5173/build-target.json",
          "json_path": "target",
          "equals": "public-website"
        }
      ]
    },
    {
      "name": "mesh-health-check-data-init",
      "container": "ukmesh-full-mesh-health-check-data-init-1",
