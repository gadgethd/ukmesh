FROM scratch AS healthcheck-source
ARG MESH_HEALTH_CHECK_REF
ADD https://github.com/gadgethd/meshcore-health-check.git#${MESH_HEALTH_CHECK_REF} /

FROM node:26-slim@sha256:ec7758ee051e457b468b32bde57b0879010b325bb9862718e9615225ce4aaae1 AS builder
WORKDIR /app

COPY --from=healthcheck-source /package.json /package-lock.json ./
COPY --from=healthcheck-source /scripts/patch-meshcore-decoder.js ./scripts/
RUN npm ci --omit=dev --no-audit --fund=false
COPY --from=healthcheck-source /server.js /region-scopes.example.yml ./
COPY --from=healthcheck-source /lib ./lib
COPY --from=healthcheck-source /public ./public
COPY --from=healthcheck-source /regions ./regions
COPY --from=healthcheck-source /LICENSE ./LICENSE
COPY --from=healthcheck-source /LICENSES ./LICENSES

FROM node:26-alpine@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
ARG SOURCE_REVISION=unknown
ARG UKMESH_VERSION=2.0.0
ARG MESH_HEALTH_CHECK_REF
RUN echo "$MESH_HEALTH_CHECK_REF" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.version="${UKMESH_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/gadgethd/ukmesh" \
      io.ukmesh.health-check.revision="${MESH_HEALTH_CHECK_REF}"
WORKDIR /app
COPY --from=builder --chown=node:node /app /app
COPY docker/mesh-health-check-entrypoint.sh /usr/local/bin/mesh-health-check-entrypoint.sh
RUN rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx \
  && chmod +x /usr/local/bin/mesh-health-check-entrypoint.sh \
  && mkdir -p /app/data \
  && chown -R node:node /app/data

ENV NODE_ENV=production
EXPOSE 3090
USER node
ENTRYPOINT ["mesh-health-check-entrypoint.sh"]
CMD ["node", "server.js"]
