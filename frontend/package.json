{
  "name": "meshcore-analytics-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "budget": "node scripts/check-performance-budgets.mjs",
    "lint:css": "node scripts/check-css-structure.mjs",
    "soak:production": "node scripts/soak-production.mjs",
    "preview": "vite preview",
    "test": "tsx --test $(find src -name '*.test.ts' -print)",
    "test:e2e": "playwright test --config=playwright.production.config.ts --project=public-desktop --project=dashboard-desktop --project=dashboard-mobile",
    "test:basemap": "VITE_APP_HOSTNAME=app.ukmesh.com VITE_BUILD_TARGET=app VITE_SITE=ukmesh VITE_NETWORK=ukmesh VITE_RF_COVERAGE_ENABLED=true npm run build && playwright test --config=playwright.basemap.config.ts",
    "test:mobile": "playwright test mobile.spec.ts --project=mobile-regression",
    "test:dev-renderer": "playwright test --config=playwright.development.config.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.4.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.3.10",
    "@deck.gl/mapbox": "^9.4.0",
    "fuse.js": "^7.5.0",
    "maplibre-gl": "6.11.2",
    "react": "19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.3.0",
    "react-is": "^19.3.0",
    "react-router": "8.4.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "8.5.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "terser": "5.51.2",
    "@types/d3-force": "^3.0.10"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
