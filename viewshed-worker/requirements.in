# Pin numpy to the GDAL base image's system numpy (1.26.4). The osgeo gdal_array
# C extension is built against that ABI; letting scipy pull numpy 2.x into the
# venv breaks `from osgeo import gdal_array` ("numpy.core.multiarray failed to
# import") and thus all elevation sampling / coverage computation.
numpy==2.2.6
scipy==1.18.0
