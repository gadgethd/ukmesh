prometheus-client==0.26.0
# shapely is inherited from the base image's python3-shapely apt package
# (built for the image's Python 3.14 / GEOS 3.14 ABI). No pip wheel exists for
# cp314, and source builds are incompatible with GEOS 3.14 headers, so it must
# NOT be listed here.
# Pin numpy to the GDAL base image's system numpy (2.3.5). The osgeo gdal_array
# C extension is built against that ABI; letting scipy pull another numpy into
# the venv breaks `from osgeo import gdal_array` ("numpy.core.multiarray failed
# to import") and thus all elevation sampling / coverage computation.
numpy==2.5.2
scipy==1.18.0
